# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: only if you route the API through a gateway.
# ANTHROPIC_BASE_URL=
# Model used by the tutor. Read from configuration, never hard-coded.
FAHIM_MODEL=claude-sonnet-5-5
# Prices in USD per million tokens, used only to estimate session cost.
FAHIM_PRICE_INPUT_PER_MTOK=2
FAHIM_PRICE_OUTPUT_PER_MTOK=10
# Signs the student cookie of the web app. Required in production, at least 32 characters.
# In development a random per-process secret is used when it is empty.
# FAHIM_COOKIE_SECRET=
# Shared with the reverse proxy (Caddy), which sends it in X-Fahim-Proxy-Secret. Required in production,
# at least 32 characters. X-Forwarded-For is believed only on requests that carry it.
# FAHIM_PROXY_SECRET=
# Development only: "offline" plays sessions in the web app without calling the API.
# FAHIM_MODEL_PROVIDER=offline
# PostgreSQL. The application connects as the fahim_app role (row-level security applies);
# migrations run with the owner connection. Leave both empty to keep the in-memory stores.
# DATABASE_URL=postgres://fahim_app:<password>@localhost:5432/fahim
# DATABASE_ADMIN_URL=postgres://postgres:<password>@localhost:5432/fahim
# Sessions a student may start per calendar day in Morocco (Africa/Casablanca). 0 means no limit.
FAHIM_MAX_SESSIONS_PER_DAY=3
# Deployment environment: "production" or "development". Unset, it follows NODE_ENV
# (a production build is production). The local docker-compose.yml sets development.
# FAHIM_ENV=

# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: only if you route the API through a gateway.
# ANTHROPIC_BASE_URL=
# Model used by the tutor. Read from configuration, never hard-coded.
FAHIM_MODEL=claude-sonnet-5-5
# Prices in USD per million tokens, used only to estimate session cost.
FAHIM_PRICE_INPUT_PER_MTOK=2
FAHIM_PRICE_OUTPUT_PER_MTOK=10
# Signs the student cookie of the web app. Required in production, at least 32 characters.
# In development a random per-process secret is used when it is empty.
# FAHIM_COOKIE_SECRET=

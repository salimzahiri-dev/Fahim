# Production environment for docker-compose.prod.yml (docs/DEPLOY.md).
# Copy to /etc/fahim/fahim.env on the server, readable by root only (chmod 600).
# Never commit the filled-in file. Generate each random secret with:  openssl rand -base64 48

# Public name of the site; its DNS A record points to the server.
FAHIM_DOMAIN=

# PostgreSQL superuser password (migrations, backups). Random.
FAHIM_DB_PASSWORD=
# Password of the application role fahim_app (row-level security applies to it). Random, different.
FAHIM_APP_DB_PASSWORD=
# Signs the student cookie. Random, at least 32 characters.
FAHIM_COOKIE_SECRET=
# Shared by Caddy and the app; X-Forwarded-For is trusted only with it. Random, at least 32 characters.
FAHIM_PROXY_SECRET=

# Anthropic API key of the pilot (the $200/month credit).
ANTHROPIC_API_KEY=
# Optional: model name and daily sessions per student (default 3).
# FAHIM_MODEL=
# FAHIM_MAX_SESSIONS_PER_DAY=3

# Backups: the age PUBLIC key (starts with age1...). The private key never goes on the server.
BACKUP_AGE_RECIPIENT=
# S3-compatible bucket at a provider other than the server's host.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
